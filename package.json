{
  "name": "burn-after-reading",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "One-time, self-destructing secret links. Express + better-sqlite3 + AES-256-GCM.",
  "scripts": {
    "predev": "vite build",
    "dev": "concurrently -k -n vite,server -c magenta,cyan \"vite build --watch\" \"node --watch server.js\"",
    "build": "vite build",
    "start": "node server.js",
    "pretest": "npm run build",
    "test": "node --test \"test/*.test.js\"",
    "lint": "eslint .",
    "keygen": "node scripts/keygen.js"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "better-sqlite3": "^13.0.3",
    "ejs": "^7.0.2",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.5"
  }
}
