# 32 random bytes as 64 hex characters. Generate with: npm run keygen
SECRET_KEY=

# Optional, comma-separated. Old keys kept for DECRYPTION ONLY, so that rotating
# SECRET_KEY does not orphan secrets written under the previous one. Move the old
# key here when you rotate, then drop it once everything older than your longest
# TTL has expired.
SECRET_KEY_PREVIOUS=

PORT=3000

# Used to build the shareable link. Set this to your public origin in production.
BASE_URL=http://localhost:3000

# Relative to the project root.
DATABASE_PATH=data/app.db

# Optional. Shows a "Source" link in the header when set; hidden when blank.
REPO_URL=

# How many reverse-proxy hops to trust for the client's IP address.
# Leave OFF (blank or false) when the app is exposed directly — otherwise a client
# can forge X-Forwarded-For and bypass every rate limit.
# Set to 1 when behind exactly one proxy (Render, Fly, Railway, nginx, Cloudflare);
# this is also required for HSTS to be sent, since TLS terminates at the proxy.
TRUST_PROXY=

# Hard ceiling on stored rows. Rate limits cap one address; this caps everyone,
# so a distributed flood cannot fill the disk. Default 10000.
MAX_SECRETS=

# One log line per request, with the token redacted. Set to false to silence it.
LOG_REQUESTS=

# text (readable in a terminal) or json (one object per line, for log aggregators).
LOG_FORMAT=

NODE_ENV=development
