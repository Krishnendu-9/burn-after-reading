<!doctype html>
<html lang="en">
  <head>
    <%- include('partials/head', { title: 'Your secret — Burn After Reading' }) %>
  </head>
  <body class="font-sans">
    <%- include('partials/backdrop') %>
    <%- include('partials/nav') %>

    <main class="mx-auto w-full max-w-2xl px-6 pt-10">
      <section class="animate-rise text-center">
        <span class="chip mb-6 border-emerald-500/30! text-emerald-700! dark:text-emerald-400!">
          🔓 Decrypted · row deleted
        </span>
        <h1 class="text-3xl font-bold tracking-tight text-balance sm:text-4xl">
          Here it is — <span class="text-gradient">once</span>.
        </h1>
        <p class="mx-auto mt-4 max-w-md text-sm leading-relaxed text-pretty text-neutral-500 dark:text-neutral-400">
          This secret has already been wiped from the server. Refreshing or reopening
          the link shows nothing, so copy it before you leave.
        </p>
      </section>

      <section class="surface animate-rise mt-8 overflow-hidden shadow-xl shadow-neutral-900/5 [animation-delay:80ms] dark:shadow-black/40">
        <div class="relative">
          <pre
            id="secret-body"
            data-secret
            class="max-h-96 overflow-auto p-5 font-mono text-sm leading-relaxed break-words whitespace-pre-wrap transition-[filter] duration-300"
          ><%= message %></pre>

          <!-- Shown only when JS has masked the text, so a no-JS visitor still reads it. -->
          <button
            type="button"
            data-reveal
            class="absolute inset-0 hidden cursor-pointer items-center justify-center bg-white/40 text-sm font-medium backdrop-blur-[2px] transition hover:bg-white/20 dark:bg-black/30 dark:hover:bg-black/10"
          >
            <span class="btn-ghost pointer-events-none shadow-sm">👁 Click to reveal</span>
          </button>
        </div>

        <div class="flex flex-wrap items-center justify-between gap-2 border-t border-neutral-200/70 bg-neutral-100/40 px-4 py-3 dark:border-white/5 dark:bg-white/[0.02]">
          <span class="font-mono text-[11px] text-neutral-400 dark:text-neutral-600">
            created <%= createdAt %> UTC
          </span>
          <button type="button" data-copy="#secret-body" class="btn-ghost py-1.5 text-xs">
            <span data-copy-label>📋 Copy</span>
          </button>
        </div>
      </section>

      <div class="mt-4 flex items-start gap-2 rounded-xl border border-amber-300/40 bg-amber-50/60 px-3.5 py-3 text-xs leading-relaxed text-amber-800 dark:border-amber-500/20 dark:bg-amber-500/5 dark:text-amber-200/80">
        <span aria-hidden="true">🔥</span>
        <span>
          Gone for good — there is no backup, no cache, and no way to ask for it again.
        </span>
      </div>

      <a href="/" class="btn-ghost mt-3 w-full">🔥 Send a secret of your own</a>
    </main>

    <%- include('partials/footer') %>
  </body>
</html>
