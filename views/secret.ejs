<!doctype html>
<html lang="en">
  <head>
    <%- include('partials/head', { title: 'Your secret — Burn After Reading' }) %>
  </head>
  <body class="font-sans" data-reveal-ended>
    <%- include('partials/backdrop') %>
    <%- include('partials/nav') %>

    <main class="mx-auto w-full max-w-3xl px-5 pt-10 sm:px-6">
      <section class="animate-rise text-center">
        <span class="chip mb-6 border-emerald-500/30! text-emerald-700! dark:text-emerald-400!">
          <%- include('partials/icon', { icon: 'lockOpen', cls: 'h-3.5 w-3.5' }) %>
          Decrypted · deleted from the server
        </span>
        <h1 class="text-3xl font-bold tracking-tight text-balance sm:text-4xl">
          Here it is — <span class="text-gradient">once</span>.
        </h1>
        <p class="mx-auto mt-4 max-w-md text-sm leading-relaxed text-pretty text-neutral-500 dark:text-neutral-400">
          This secret has already been wiped from the server. Refreshing or reopening
          the link shows nothing, so copy it before you leave.
        </p>
      </section>

      <section class="surface animate-rise mt-8 overflow-hidden shadow-xl shadow-neutral-900/5 [animation-delay:80ms] dark:shadow-black/40">
        <div class="relative">
          <% if (clientEncrypted) { %>
          <!-- Ciphertext only. The key is in the URL fragment, which the server
               never saw; main.js decrypts it in place. -->
          <pre
            id="secret-body"
            data-secret
            data-ciphertext="<%= message %>"
            class="max-h-96 overflow-auto p-5 font-mono text-sm leading-relaxed break-words whitespace-pre-wrap transition-[filter] duration-300"
          >Decrypting…</pre>
          <noscript>
            <p class="px-5 pb-5 text-sm leading-relaxed text-amber-700 dark:text-amber-300/90">
              This secret was encrypted in the sender's browser and needs JavaScript to
              decrypt. It has already been deleted from the server, so it can't be
              opened again — ask the sender for a fresh link.
            </p>
          </noscript>
          <% } else { %>
          <pre
            id="secret-body"
            data-secret
            class="max-h-96 overflow-auto p-5 font-mono text-sm leading-relaxed break-words whitespace-pre-wrap transition-[filter] duration-300"
          ><%= message %></pre>
          <% } %>

          <!-- Shown only when JS has masked the text, so a no-JS visitor still reads it. -->
          <button
            type="button"
            data-reveal
            class="absolute inset-0 hidden cursor-pointer items-center justify-center bg-white/40 text-sm font-medium backdrop-blur-[2px] transition hover:bg-white/20 dark:bg-black/30 dark:hover:bg-black/10"
          >
            <span class="btn-ghost pointer-events-none shadow-sm"><%- include('partials/icon', { icon: 'eye' }) %> Click to reveal</span>
          </button>
        </div>

        <div class="flex flex-wrap items-center justify-between gap-2 border-t border-neutral-200/70 bg-neutral-100/40 px-4 py-3 dark:border-white/5 dark:bg-white/[0.02]">
          <%#
            SQLite stores "YYYY-MM-DD HH:MM:SS" in UTC. The server can't know the
            reader's time zone, so it renders UTC — correct, if unfriendly — and
            main.js rewrites it in the browser as relative plus local time. The
            exact UTC value stays in `datetime` and in the hover title.
          %>
          <time
            data-created
            datetime="<%= createdAt.replace(' ', 'T') %>Z"
            title="<%= createdAt %> UTC"
            class="text-xs text-neutral-500 dark:text-neutral-400"
          >created <%= createdAt %> UTC</time>
          <button type="button" data-copy="#secret-body" class="btn-ghost py-1.5 text-xs">
            <%- include('partials/icon', { icon: 'copy', cls: 'h-3.5 w-3.5', attrs: 'data-copy-icon' }) %>
            <%- include('partials/icon', { icon: 'check', cls: 'hidden h-3.5 w-3.5', attrs: 'data-copied-icon' }) %>
            <span data-copy-label aria-live="polite">Copy</span>
          </button>
        </div>
      </section>

      <div class="mt-4 flex items-start gap-2 rounded-xl border border-amber-300/40 bg-amber-50/60 px-3.5 py-3 text-xs leading-relaxed text-amber-800 dark:border-amber-500/20 dark:bg-amber-500/5 dark:text-amber-200/90">
        <%- include('partials/icon', { icon: 'flame', cls: 'mt-px h-3.5 w-3.5' }) %>
        <span>
          Deleted from the server — this link won't open it again, and there's no way
          to ask for it back.
        </span>
      </div>

      <a href="/" class="btn-ghost mt-3 w-full"><%- include('partials/icon', { icon: 'flame' }) %> Send a secret of your own</a>
    </main>

    <%- include('partials/footer') %>
  </body>
</html>
