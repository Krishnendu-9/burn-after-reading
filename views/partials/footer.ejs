<footer class="mx-auto w-full max-w-3xl px-6 pt-16 pb-10">
  <div class="flex flex-col items-center gap-4 border-t border-neutral-200/70 pt-8 dark:border-white/5">
    <div class="flex flex-wrap justify-center gap-2">
      <% ['Node.js', 'Express', 'SQLite', 'Tailwind', 'Vite'].forEach(function (tech) { %>
      <span class="chip"><%= tech %></span>
      <% }); %>
    </div>
    <p class="text-center text-xs text-neutral-400 dark:text-neutral-600">
      No accounts · No trackers · No recovery — that's the point.
    </p>
  </div>
</footer>
