<!--
  Full-bleed sticky navbar: spans the whole viewport, flush to the top edge, with
  a frosted background so content scrolls underneath it. The centre links are
  absolutely positioned so they sit on the true midpoint of the screen rather
  than drifting with the width of the logo and the right-hand controls.

  Pass `{ home: true }` from the compose page: the "New secret" button would
  only link to the page the visitor is already on, and would compete with the
  form's own primary button.
-->
<div
  data-nav
  class="sticky top-0 z-50 border-b border-neutral-200/70 bg-white/70 backdrop-blur-xl transition-shadow duration-300 dark:border-white/10 dark:bg-neutral-950/60 data-scrolled:shadow-lg data-scrolled:shadow-neutral-900/5 dark:data-scrolled:shadow-black/40"
>
  <div class="relative flex h-16 items-center justify-between gap-3 px-4 sm:px-6 lg:px-8">
    <!-- Logo: amber flame on a dark disc — an orange glyph on an orange fill had
         no contrast and read as a smudge at this size. -->
    <a href="/" class="group flex shrink-0 items-center gap-2.5 rounded-full">
      <span
        class="flex h-9 w-9 items-center justify-center rounded-full bg-neutral-900 ring-1 ring-orange-500/25 transition group-hover:ring-orange-500/60 dark:bg-white/[0.07]"
      >
        <%- include('icon', { icon: 'flame', cls: 'h-[18px] w-[18px] text-orange-500 transition group-hover:scale-110', attrs: 'stroke-width="2"' }) %>
      </span>
      <span class="text-sm font-semibold tracking-tight">Burn After Reading</span>
    </a>

    <!-- Centre links -->
    <nav class="absolute left-1/2 hidden -translate-x-1/2 items-center gap-1 md:flex" aria-label="Main">
      <a href="/#how" class="nav-link">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4" aria-hidden="true">
          <path d="M9 18h6M10 21h4" />
          <path d="M12 3a6 6 0 0 0-3.6 10.8c.4.3.6.8.6 1.2h6c0-.4.2-.9.6-1.2A6 6 0 0 0 12 3Z" />
        </svg>
        How it works
      </a>

      <a href="/#security" class="nav-link">
        <%- include('icon', { icon: 'shield' }) %>
        Security
      </a>

      <% if (repoUrl) { %>
      <a href="<%= repoUrl %>" target="_blank" rel="noopener noreferrer" class="nav-link">
        <svg viewBox="0 0 16 16" fill="currentColor" class="h-4 w-4" aria-hidden="true">
          <path
            d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
          />
        </svg>
        GitHub
      </a>
      <% } %>
    </nav>

    <!-- Controls -->
    <div class="flex shrink-0 items-center gap-2">
      <button
        type="button"
        data-theme-toggle
        data-requires-js
        class="flex h-9 w-9 cursor-pointer items-center justify-center rounded-full border border-neutral-200 bg-white/60 text-neutral-600 transition hover:border-neutral-300 hover:text-neutral-900 dark:border-white/10 dark:bg-white/[0.04] dark:text-neutral-400 dark:hover:border-white/20 dark:hover:text-white"
        title="Toggle theme"
        aria-label="Toggle theme"
      >
        <svg data-icon-sun viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" class="hidden h-4 w-4" aria-hidden="true">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
        </svg>
        <svg data-icon-moon viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="hidden h-4 w-4" aria-hidden="true">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" />
        </svg>
      </button>

      <% if (!locals.home) { %>
      <a
        href="/"
        class="group flex items-center gap-1.5 rounded-full bg-gradient-to-b from-amber-500 to-orange-600 py-2 pr-3 pl-4 text-sm font-semibold text-white shadow-lg shadow-orange-600/25 transition-all duration-200 hover:from-amber-400 hover:to-orange-500 hover:shadow-orange-600/40 active:scale-[0.98]"
      >
        <span class="hidden sm:inline">New secret</span>
        <span class="sm:hidden">New</span>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="h-3.5 w-3.5 transition-transform duration-200 group-hover:translate-x-0.5" aria-hidden="true">
          <path d="m9 5 7 7-7 7" />
        </svg>
      </a>
      <% } %>
    </div>
  </div>
</div>
